# ── 依赖（可由 lockfile 重装）────────────────────────────────
node_modules/

# ── 浏览器验证脚本的一次性 profile ──────────────────────────
# 约 36M，且 .chrome-login 里带着实测登录态，不该进版本库
png/.chrome-*/

# ── 验证截图：一次性证据，重跑对应 png/verify_*.js 即可再生 ──
png/*.png

# ── 运行时数据与日志 ────────────────────────────────────────
# work-hours.db 是真实打卡数据，不进版本库：
#   1) sqlite 二进制 + WAL 每次写都产生整块 diff，仓库会迅速膨胀
#   2) 版本库不是数据备份手段，数据需要独立的导出/备份流程
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/*.log

# ── 时间戳备份：已重建为 main 上的历史提交，git 接管后不再入库 ──
# 原始 .bak.* 文件保留在磁盘上，未删除
*.bak.*

# ── 回收站 ──────────────────────────────────────────────────
.trash/

# ── 杂项 ────────────────────────────────────────────────────
.DS_Store
*.tmp
